# Set this to the stable custom production domain, never to a per-deployment
# EdgeOne preview URL. It is read only by the server at request time.
SITE_URL=https://your-public-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy compatibility only. Prefer SUPABASE_PUBLISHABLE_KEY for new setups.
# SUPABASE_ANON_KEY=your-legacy-anon-key

# Commit and build time are generated automatically from git during pnpm build.
ACAORA_ENVIRONMENT=development

# Optional server-managed defaults. PaperLab also supports per-session BYOK.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
