# Set this to the stable custom production domain, never to a per-deployment
# EdgeOne preview URL. It is read only by the server at request time.
SITE_URL=https://your-public-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# EdgeOne should inject these from its Git/CI context. ACAORA_COMMIT_SHA must
# equal the deployed main commit; the production smoke test rejects "unknown".
ACAORA_COMMIT_SHA=
ACAORA_BUILD_TIME=
ACAORA_ENVIRONMENT=development

# Optional server-managed defaults. PaperLab also supports per-session BYOK.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
